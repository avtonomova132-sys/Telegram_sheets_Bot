# Telegram-бот: токен от @BotFather
BOT_TOKEN=

# Распознавание голосовых сообщений (Whisper)
OPENAI_API_KEY=

# Распознавание текста о передачах курсов "Пять домов" (/добавить)
ANTHROPIC_API_KEY=

# Необязательно: путь к файлу данных о передачах, по умолчанию /data/peredachi.json
# (Railway Volume, тот же, что для прогресса стихов)
# PEREDACHI_PATH=/data/peredachi.json

# Авто-перевод в группах (/translate_on, /translate_off) использует тот же
# ANTHROPIC_API_KEY выше. Необязательно: путь к списку групп с включённым
# переводом, по умолчанию /data/translate_chats.json
# TRANSLATE_CHATS_PATH=/data/translate_chats.json
