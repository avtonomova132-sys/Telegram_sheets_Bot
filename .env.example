# Telegram-бот: токен от @BotFather
BOT_TOKEN=

# Распознавание голосовых сообщений (Whisper)
OPENAI_API_KEY=

# Распознавание текста о передачах курсов "Пять домов" (/добавить)
ANTHROPIC_API_KEY=

# Необязательно: путь к файлу данных о передачах, по умолчанию /data/peredachi.json
# (Railway Volume, тот же, что для прогресса стихов)
# PEREDACHI_PATH=/data/peredachi.json

# Необязательно: путь к таблице соответствий "internal group id → пригласительная
# ссылка" (/группы), по умолчанию /data/group-links.json
# GROUP_LINKS_PATH=/data/group-links.json

# Личный chat_id Елены — куда бот шлёт ежедневное изречение, напоминания о
# передачах, ежедневную diff-проверку хостов (9:00 по Бали) и воскресную
# авторассылку /weekly (10:00 по Бали, см. WEEKLY_ANNOUNCE_HOUR ниже). Без
# него все рассылки отключены (просто не запускаются).
MY_CHAT_ID=

# Необязательно: час (по Бали) воскресной автоотправки /weekly. По
# умолчанию 10.
# WEEKLY_ANNOUNCE_HOUR=10

# Необязательно: путь к отметке "когда в последний раз отправляли
# воскресную рассылку /weekly", по умолчанию /data/weekly_announce_state.json
# (Railway Volume).
# WEEKLY_ANNOUNCE_STATE_PATH=/data/weekly_announce_state.json

# Список chat_id через запятую, кому доступны owner-only команды
# (/добавить, /дубли, /разделить, /группы, /обновитьссылки) — организаторы,
# которым Elena доверяет вносить расписание передач. MY_CHAT_ID всегда
# доверенный и дублировать его сюда не нужно.
# TRUSTED_USER_IDS=123456789,987654321

# Необязательно: путь к снимку состояния для периодической diff-проверки
# хостов (какие эфиры/хосты были на момент прошлой проверки), по умолчанию
# /data/host_diff_state.json (Railway Volume, тот же, что для прогресса
# стихов). Список отслеживаемых вкладок — в daily-check-tabs.json.
# HOST_DIFF_STATE_PATH=/data/host_diff_state.json

# Необязательно: интервал (в минутах) периодической diff-проверки хостов —
# как часто бот сверяет daily-check-tabs.json с прошлым снимком. По
# умолчанию 180 (раз в 3 часа — Elena сознательно выбрала не гнаться за
# скоростью уведомлений ради втрое меньшей нагрузки на Google Sheets API).
# Раньше проверка была once-per-day после 9:00 по Бали, теперь крутится
# весь день с этим интервалом. Значения кратные 60 (60, 120, 180...) идут
# через поле часов cron'а и всегда ровные; значения меньше 60 лучше брать
# делителем 60 (5, 10, 15, 20, 30...), иначе на границе часа шаг "подрежется".
# HOST_DIFF_CHECK_INTERVAL_MINUTES=180

# Необязательно: путь к файлу со списком артикулов для /габариты
# (/z), по умолчанию /data/articles.csv (Railway Volume)
# ARTICLES_PATH=/data/articles.csv

# Список chat_id групп (через запятую) на которые бот подписан и следит за
# новыми сообщениями в поиске анонсов передач — при находке шлёт Elena
# (MY_CHAT_ID) уведомление с распознанными данными, ничего не сохраняет
# автоматически. Требует отключённый Privacy Mode у бота в каждой такой
# группе (у @BotFather), иначе Telegram не доставит боту чужие сообщения.
# Пусто по умолчанию — мониторинг не активен, пока Elena не добавит группу.
# WATCHED_GROUP_IDS=-1001234567890,-1009876543210

# Список chat_id групп (через запятую), куда дублируется то же 20-минутное
# напоминание о передаче, что уже уходит на MY_CHAT_ID (тот же текст, та же
# защита от повторной отправки). Пусто по умолчанию — рассылка в группы не
# активна, личное напоминание не затрагивает.
# BROADCAST_GROUP_IDS=-1001234567890,-1009876543210

# Авто-перевод в группах (/translate_on, /translate_off) использует тот же
# ANTHROPIC_API_KEY выше. Необязательно: путь к списку групп с включённым
# переводом, по умолчанию /data/translate_chats.json
# TRANSLATE_CHATS_PATH=/data/translate_chats.json
