# Telegram-бот: токен от @BotFather
BOT_TOKEN=

# Распознавание голосовых сообщений (Whisper)
OPENAI_API_KEY=

# Распознавание текста о передачах курсов "Пять домов" (/добавить)
ANTHROPIC_API_KEY=

# Необязательно: путь к файлу данных о передачах, по умолчанию /data/peredachi.json
# (Railway Volume, тот же, что для прогресса стихов)
# PEREDACHI_PATH=/data/peredachi.json

# Необязательно: путь к таблице соответствий "internal group id → пригласительная
# ссылка" (/группы), по умолчанию /data/group-links.json
# GROUP_LINKS_PATH=/data/group-links.json

# Личный chat_id Елены — куда бот шлёт ежедневное изречение, напоминания о
# передачах, ежедневную diff-проверку хостов (9:00 по Бали) и воскресную
# авторассылку /weekly (10:00 по Бали, см. WEEKLY_ANNOUNCE_HOUR ниже). Без
# него все рассылки отключены (просто не запускаются).
MY_CHAT_ID=

# Необязательно: час (по Бали) воскресной автоотправки /weekly. По
# умолчанию 10.
# WEEKLY_ANNOUNCE_HOUR=10

# Необязательно: путь к отметке "когда в последний раз отправляли
# воскресную рассылку /weekly", по умолчанию /data/weekly_announce_state.json
# (Railway Volume).
# WEEKLY_ANNOUNCE_STATE_PATH=/data/weekly_announce_state.json

# Список chat_id через запятую, кому доступны owner-only команды
# (/добавить, /дубли, /разделить, /группы, /обновитьссылки) — организаторы,
# которым Elena доверяет вносить расписание передач. MY_CHAT_ID всегда
# доверенный и дублировать его сюда не нужно.
# TRUSTED_USER_IDS=123456789,987654321

# Необязательно: путь к снимку состояния для ежедневной diff-проверки
# хостов (какие эфиры/хосты были на момент прошлой проверки), по умолчанию
# /data/host_diff_state.json (Railway Volume, тот же, что для прогресса
# стихов). Список отслеживаемых вкладок — в daily-check-tabs.json.
# HOST_DIFF_STATE_PATH=/data/host_diff_state.json

# Необязательно: путь к файлу со списком артикулов для /габариты
# (/z), по умолчанию /data/articles.csv (Railway Volume)
# ARTICLES_PATH=/data/articles.csv
